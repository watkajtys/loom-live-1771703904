+import React from 'react';
+import type { Node } from '../types';
+import { motion } from 'framer-motion';
+
+export type NodeCardVariant = 'focused' | 'child' | 'minimized';
+
+interface NodeCardProps {
+  node: Node;
+  variant: NodeCardVariant;
+  onClick?: () => void;
+  onDoubleClick?: () => void;
+  className?: string;
+  style?: React.CSSProperties;
+}
+
+export const NodeCard: React.FC<NodeCardProps> = ({ node, variant, onClick, onDoubleClick, className = '', style }) => {
+  if (variant === 'minimized') {
+     return (
+        <motion.div 
+            layoutId={`node-${node.id}`}
+            className={`glass-card prism-border-gradient h-64 w-96 rounded-3xl p-6 flex flex-col justify-between opacity-40 blur-[2px] transition-all duration-700 ease-out pointer-events-none ${className}`}
+            style={style}
+        >
+            <div className="flex items-center gap-3 mb-4">
+                <span className="material-symbols-outlined text-slate-400">account_tree</span>
+                <h3 className="text-lg font-bold text-slate-400">{node.title}</h3>
+            </div>
+             <div className="text-slate-400 text-sm truncate">
+                {node.content}
+            </div>
+        </motion.div>
+     )
+  }
+
+  if (variant === 'focused') {
+    return (
+        <motion.div 
+            layoutId={`node-${node.id}`}
+            className={`glass-card prism-border-gradient w-[500px] rounded-[32px] p-8 shadow-prism shadow-glow-purple flex flex-col gap-6 relative overflow-hidden bg-white/40 group ${className}`}
+            style={style}
+            onClick={onClick}
+            onDoubleClick={onDoubleClick}
+        >
+            <div className="flex items-start justify-between">
+                <div className="flex items-center gap-4">
+                    <div className={`h-14 w-14 rounded-2xl bg-gradient-to-br from-prism-cyan/10 to-prism-purple/10 border border-white flex items-center justify-center`}>
+                        <span className={`material-symbols-outlined text-3xl ${node.color === 'purple' ? 'text-prism-purple' : 'text-prism-cyan'}`}>
+                             {node.type === 'act' ? 'auto_stories' : 'forest'}
+                        </span>
+                    </div>
+                    <div>
+                        <h1 className="text-2xl font-bold text-slate-800">{node.title}</h1>
+                        {node.subtitle && <p className="text-sm text-slate-500 font-medium">{node.subtitle}</p>}
+                    </div>
+                </div>
+                <button className="text-slate-400 hover:text-prism-cyan transition-colors">
+                    <span className="material-symbols-outlined">more_vert</span>
+                </button>
+            </div>
+            
+            <div className="bg-white/50 rounded-xl p-4 border border-white/60 text-slate-600 leading-relaxed text-sm">
+                {node.content}
+            </div>
+
+            <div className="grid grid-cols-2 gap-3">
+                {/* Placeholder actions based on design */}
+                <div className="group/action cursor-pointer rounded-xl bg-white p-3 border border-slate-100 shadow-sm hover:shadow-md hover:border-prism-cyan transition-all">
+                    <div className="flex items-center gap-2 mb-1">
+                        <span className="material-symbols-outlined text-sm text-prism-cyan">arrow_forward</span>
+                        <span className="font-bold text-sm text-slate-700 group-hover/action:text-prism-cyan">Investigate</span>
+                    </div>
+                    <div className="h-1 w-full bg-slate-100 rounded-full overflow-hidden">
+                        <div className="h-full w-2/3 bg-prism-cyan"></div>
+                    </div>
+                </div>
+            </div>
+
+            <div className="absolute top-0 right-0 -mt-10 -mr-10 h-32 w-32 rounded-full bg-prism-purple/5 blur-2xl pointer-events-none"></div>
+            <div className="absolute bottom-0 left-0 -mb-10 -ml-10 h-32 w-32 rounded-full bg-prism-cyan/5 blur-2xl pointer-events-none"></div>
+            
+             <div className="absolute -bottom-12 left-1/2 -translate-x-1/2 bg-prism-dark text-white text-xs font-bold px-3 py-1 rounded-full shadow-lg opacity-0 transition-opacity duration-300 group-hover:opacity-100 pointer-events-none">
+                Double-click to dive
+            </div>
+        </motion.div>
+    );
+  }
+
+  // Child node / smaller variant
+  return (
+    <motion.div 
+        layoutId={`node-${node.id}`}
+        className={`glass-card w-64 rounded-2xl p-5 border border-prism-cyan/30 shadow-prism backdrop-blur-sm bg-white/30 cursor-pointer transition-all hover:scale-105 hover:z-30 ${className} ${node.isLocked ? 'opacity-80' : ''}`}
+        style={style}
+        onClick={onClick}
+        onDoubleClick={onDoubleClick}
+    >
+        <div className="flex items-center gap-3 mb-2">
+            <span className={`material-symbols-outlined ${node.color === 'purple' ? 'text-prism-purple' : 'text-prism-cyan'}`}>
+                {node.isLocked ? 'lock' : 'waves'}
+            </span>
+            <h3 className="font-bold text-slate-700">{node.title}</h3>
+        </div>
+        {node.subtitle && <p className="text-xs text-slate-500">{node.subtitle}</p>}
+        {!node.isLocked && (
+             <div className="absolute -top-1 -right-1 h-3 w-3 rounded-full bg-prism-cyan animate-ping"></div>
+        )}
+        {!node.isLocked && (
+            <div className="absolute -top-1 -right-1 h-3 w-3 rounded-full bg-prism-cyan"></div>
+        )}
+    </motion.div>
+  );
+};
