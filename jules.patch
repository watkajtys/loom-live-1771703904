+++ b/src/components/Navigation.tsx
@@ -0,0 +1,76 @@
+import React from 'react';
+import type { Node } from '../types';
+import { nodes } from '../data';
+
+interface NavigationProps {
+  currentNodeId: string;
+  onNavigate: (id: string) => void;
+}
+
+export const Navigation: React.FC<NavigationProps> = ({ currentNodeId, onNavigate }) => {
+  // Calculate breadcrumbs
+  const breadcrumbs: Node[] = [];
+  let current: Node | undefined = nodes[currentNodeId];
+  while (current) {
+    breadcrumbs.unshift(current);
+    if (current.parentId) {
+      current = nodes[current.parentId];
+    } else {
+      current = undefined;
+    }
+  }
+
+  return (
+    <nav className="fixed top-0 left-0 right-0 z-50 flex items-center justify-between px-8 py-4 pointer-events-none">
+        <div className="glass-card pointer-events-auto flex items-center gap-3 rounded-2xl px-5 py-3 shadow-prism border border-white/50">
+            <div className="h-8 w-8 rounded-lg bg-gradient-to-br from-prism-cyan to-prism-purple flex items-center justify-center text-white shadow-glow-purple">
+                <span className="material-symbols-outlined text-[20px]">all_inclusive</span>
+            </div>
+            <span className="font-bold text-lg tracking-tight text-slate-800">Prism<span className="font-light text-slate-500">Canvas</span></span>
+        </div>
+
+        <div className="glass-card pointer-events-auto flex items-center gap-1 rounded-full px-2 py-2 shadow-prism border border-white/50 max-w-[50vw] overflow-hidden">
+             <button
+                onClick={() => onNavigate('root')}
+                className="flex h-10 w-10 items-center justify-center rounded-full hover:bg-slate-100 transition-colors group"
+             >
+                <span className="material-symbols-outlined text-slate-400 group-hover:text-prism-purple">home</span>
+             </button>
+             
+             {breadcrumbs.map((node, index) => {
+                 if (node.id === 'root') return null;
+                 const isLast = index === breadcrumbs.length - 1;
+                 
+                 return (
+                     <React.Fragment key={node.id}>
+                        <span className="material-symbols-outlined text-slate-300 text-sm">chevron_right</span>
+                        <button 
+                            onClick={() => onNavigate(node.id)}
+                            className={`flex items-center gap-2 px-3 py-1.5 rounded-full transition-colors group ${isLast ? 'bg-white shadow-sm border border-slate-100' : 'hover:bg-slate-100'}`}
+                        >
+                            <span className={`material-symbols-outlined text-[18px] ${node.color === 'purple' ? 'text-prism-purple' : 'text-prism-cyan'}`}>
+                                {node.type === 'act' ? 'auto_stories' : 'forest'}
+                            </span>
