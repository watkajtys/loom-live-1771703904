new file mode 100644
index 0000000..cc9e55a
--- /dev/null
+++ b/src/components/ZoomableCanvas.tsx
@@ -0,0 +1,111 @@
+import React from 'react';
+import { nodes } from '../data';
+import { NodeCard } from './NodeCard';
+import { AnimatePresence, motion } from 'framer-motion';
+
+interface ZoomableCanvasProps {
+  currentNodeId: string;
+  onNavigate: (id: string) => void;
+}
+
+export const ZoomableCanvas: React.FC<ZoomableCanvasProps> = ({ currentNodeId, onNavigate }) => {
+  const currentNode = nodes[currentNodeId];
+  const parentNode = currentNode.parentId ? nodes[currentNode.parentId] : null;
+  const childNodes = (currentNode.children || []).map(id => nodes[id]).filter(Boolean);
+
+  return (
+    <main className="relative w-full h-full flex items-center justify-center overflow-hidden zoetrope-layer">
+        
+        {/* Parent Node (Background / Previous) - positioned top-leftish */}
+        <AnimatePresence>
+            {parentNode && (
+                 <motion.div 
+                    key={`parent-${parentNode.id}`}
+                    initial={{ opacity: 0, scale: 0.8, x: -50, y: -50 }}
+                    animate={{ opacity: 1, scale: 1, x: 0, y: 0 }}
+                    exit={{ opacity: 0, scale: 0.8, x: -50, y: -50 }}
+                    transition={{ duration: 0.7 }}
+                    className="absolute top-[20%] left-[20%] -translate-x-1/2 -translate-y-1/2 z-0"
+                 >
+                    <NodeCard 
+                        node={parentNode} 
+                        variant="minimized" 
+                        onClick={() => onNavigate(parentNode.id)}
+                    />
+                 </motion.div>
+            )}
+        </AnimatePresence>
+
+        {/* Current Node - Centered */}
+        <div className="relative z-20">
+             <AnimatePresence mode="wait">
+                <motion.div
+                    key={`current-${currentNode.id}`}
+                    initial={{ opacity: 0, scale: 0.8 }}
+                    animate={{ opacity: 1, scale: 1 }}
+                    exit={{ opacity: 0, scale: 1.2 }}
+                    transition={{ duration: 0.5 }}
+                    className="hover:scale-105 transition-transform duration-500"
+                >
+                    <NodeCard 
+                        node={currentNode} 
+                        variant="focused" 
+                        onDoubleClick={() => { /* maybe zoom in to first child? or just stay */ }}
+                    />
+                </motion.div>
+             </AnimatePresence>
+        </div>
+
+        {/* Child Nodes - Positioned relative to center */}
+        {childNodes.map((child, index) => {
+            // If position is not defined, distribute in a circle
+            const angle = (index / childNodes.length) * 2 * Math.PI;
+            const radius = 350; // Distance from center
+            
+            const x = child.position?.x ?? Math.cos(angle) * radius;
+            const y = child.position?.y ?? Math.sin(angle) * radius;
+
+            return (
+                <motion.div 
+                    key={`child-${child.id}`}
+                    className="absolute z-10 top-1/2 left-1/2"
+                    initial={{ opacity: 0, scale: 0, x: 0, y: 0 }}
+                    animate={{ 
+                        opacity: 1, 
+                        scale: 1, 
+                        x: x,
+                        y: y
+                    }}
+                    exit={{ opacity: 0, scale: 0 }}
+                    transition={{ delay: index * 0.1, duration: 0.5 }}
+                >
+                    <div className="-translate-x-1/2 -translate-y-1/2"> {/* Center the card itself */}
+                        <NodeCard 
+                            node={child} 
+                            variant="child" 
+                            onDoubleClick={() => !child.isLocked && onNavigate(child.id)}
+                        />
+                    </div>
+                </motion.div>
+            );
+        })}
+        
+        {/* Optional: SVG lines connecting center to children */}
+        <svg className="absolute inset-0 h-full w-full pointer-events-none z-0 overflow-visible">
+            <defs>
+                <linearGradient id="grad1" x1="0%" x2="100%" y1="0%" y2="0%">
+                    <stop offset="0%" style={{ stopColor: '#06b6d4', stopOpacity: 1 }} />
+                    <stop offset="100%" style={{ stopColor: '#a855f7', stopOpacity: 1 }} />
+                </linearGradient>
+            </defs>
+            {/* Since SVG is full screen, 50% is center. */}
+            <g transform="translate(50%, 50%)"> {/* Not valid SVG transform, need pixels. */}
+               {/* Skipping dynamic SVG lines for now as getting center pixel coordinates requires window size which is complex in simple React without hooks. 
+                   The design has static paths. We could use a fixed size viewBox if we knew the aspect ratio.
+               */}
+            </g>
+        </svg>
+
+    </main>
+  );
+};
